# Copy this file to .env and fill in your own model API key.
# DeepSeek is the default; any OpenAI-compatible API works (README 4.6).
#   OpenAI:  https://api.openai.com/v1        gpt-4o-mini
#   Ollama:  http://localhost:11434/v1        llama3.1   (any non-empty key)
# Never commit .env.
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
